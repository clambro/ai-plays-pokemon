@@ -494,7 +497,7 @@ AIMoveChoiceModification3:
 	ld a, [wEnemyMoveType]
 	ld d, a
 	ld hl, wEnemyMonMoves  ; enemy moves
-	ld bc, NUM_MOVES + 1
+	ld b, NUM_MOVES + 1
 	ld c, $0
 .loopMoves
 	dec b
@@ -1247,4 +1250,4 @@ UndoBurnParStats:
 .return
 	xor a
 	ld [de], a	;reset the stat change bits
-	ret
\ No newline at end of file
