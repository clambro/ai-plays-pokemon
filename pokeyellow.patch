ROM patches for the Pokemon Yellow Legacy decomp (resources/pokeyellow/).
Apply with: cd resources/pokeyellow && git apply ../../pokeyellow.patch && make

1. Fix badge boost branch condition for Pikachu.
   The ROM has a bug where `jr nz` is used instead of `jr z`, causing
   non-Pikachu Pokemon to get the 25% boost intended for Pikachu, and
   Pikachu to get the 12.5% boost intended for everyone else.

2. Fix AI neutral type effectiveness constant.
   Yellow Legacy's Layer 3 trainer AI compares against `EFFECTIVE`, but
   `AIGetTypeEffectiveness` still initialized neutral matchups with `$10`
   (hex 16). That caused neutral damaging moves to be encouraged like
   super-effective ones. Initialize neutral to `EFFECTIVE` instead.

3. Fix AI resisted-move fallback loop bound.
   The loop counts moves in `b`, but Legacy initializes `bc` instead,
   leaving `b` at zero. It can read past the four move slots and mistake
   unrelated data for a better attack, incorrectly discouraging real moves.
   Initialize `b` to NUM_MOVES + 1, as in original Yellow.

4. Fix the trainer AI's Mirror Move history check.
   Read wPlayerUsedMove, the same history used when Mirror Move executes,
   instead of wPlayerLastSelectedMove, which Legacy never updates.

5. Complete the trainer AI's switch and status-cure bookkeeping.
   Preserve the outgoing mon's types and status on accepted voluntary switches,
   and its previous status on successful active-mon cures. Use the saved types
   for effectiveness scoring so the AI does not evaluate the replacement.
   Clear action snapshots each turn, including after skipped AI selections.

diff --git a/engine/battle/core.asm b/engine/battle/core.asm
index b9ae299..78ecaa4 100644
--- a/engine/battle/core.asm
+++ b/engine/battle/core.asm
@@ -293,6 +293,10 @@ EnemyRanText:
 	text_end

 MainInBattleLoop:
+	; Saved AI target data belongs only to the current player action.
+	xor a
+	ld [wAIMoveSpamAvoider], a
+	ld [wAITargetMonStatus], a
 	call ReadPlayerMonCurHPAndStatus
 	ld hl, wBattleMonHP
 	ld a, [hli]
@@ -2585,6 +2589,12 @@ PartyMenuOrRockOrRun:
 .notAlreadyOut
 	call HasMonFainted
 	jp z, .partyMonDeselected ; can't switch to fainted mon
+	; Preserve the outgoing target only after a voluntary switch is accepted.
+	callfar StoreBattleMonTypes
+	ld a, [wBattleMonStatus]
+	ld [wAITargetMonStatus], a
+	ld a, 2
+	ld [wAIMoveSpamAvoider], a
 	ld a, $1
 	ld [wActionResultOrTookBattleTurn], a
 	call GBPalWhiteOut
@@ -5550,11 +5560,16 @@ AIGetTypeEffectiveness:
 	ld a, [wEnemyMoveType]
 	ld d, a                    ; d = type of enemy move
 	ld hl, wBattleMonType
+	ld a, [wAIMoveSpamAvoider]
+	cp 2
+	jr nz, .targetTypes
+	ld hl, wAITargetMonType1 ; evaluate the outgoing mon, not its replacement
+.targetTypes
 	ld b, [hl]                 ; b = type 1 of player's pokemon
 	inc hl
 	ld c, [hl]                 ; c = type 2 of player's pokemon
 	; initialize to neutral effectiveness
-	ld a, $10 ; bug: should be EFFECTIVE (10)
+	ld a, EFFECTIVE
 	ld [wTypeEffectiveness], a
 	ld hl, TypeEffects
 .loop
@@ -6883,7 +6898,7 @@ ApplyBadgeStatBoosts:
 	rr e
     ld a, [wBattleMonSpecies] ; Check if the species is Pikachu
     cp PIKACHU
-    jr nz, .continue ; times by 1.25 if its Pikachu
+    jr z, .continue ; Pikachu gets 1.25x, others get 1.125x
 	srl d
 	rr e
 .continue
diff --git a/engine/battle/trainer_ai.asm b/engine/battle/trainer_ai.asm
